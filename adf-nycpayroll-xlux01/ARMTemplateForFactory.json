									"name": "FailInvalidFiscalYear",
									"type": "Fail",
									"dependsOn": [],
									"userProperties": [],
									"typeProperties": {
										"message": "MinimumFiscalYear must be 2020 or 2021 for this snapshot.",
										"errorCode": "InvalidFiscalYear"
									}
								}
							]
						}
					}
				],
